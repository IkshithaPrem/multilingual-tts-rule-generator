{
  "language": "kn",
  "language_name": "Kannada",
  "categories": {
    "NUMBER": {
      "subcategories": {
        "cardinal_digit": {
          "description": "Spell each digit separately in Kannada",
          "examples": ["12345 as ondu eradu mooru naalku aidu"],
          "pronunciation_map": {
            "0": "ಸೊನ್ನೆ", "1": "ಒಂದು", "2": "ಎರಡು", "3": "ಮೂರು", "4": "ನಾಲ್ಕು",
            "5": "ಐದು", "6": "ಆರು", "7": "ಏಳು", "8": "ಎಂಟು", "9": "ಒಂಬತ್ತು"
          },
          "pronunciation_map_roman": {
            "0": "sonne", "1": "ondu", "2": "eradu", "3": "mooru", "4": "naalku",
            "5": "aidu", "6": "aaru", "7": "elu", "8": "entu", "9": "ombattu"
          },
          "dfa_pattern": "^[0-9]{5,}$",
          "rule_type": "digit_by_digit"
        },
        "cardinal_million_billion": {
          "description": "Cardinal numbers in Kannada scale",
          "examples": ["100 as nooru"],
          "scale_words": {
            "100": "ನೂರು", "1000": "ಸಾವಿರ", "100000": "ಲಕ್ಷ",
            "10000000": "ಕೋಟಿ"
          },
          "scale_words_roman": {
            "100": "nooru", "1000": "saavira", "100000": "laksha",
            "10000000": "koti"
          },
          "dfa_pattern": "^[0-9]{2,10}$",
          "rule_type": "cardinal"
        }
      }
    },
    "UNIT": {
      "subcategories": {
        "currency": {
          "description": "Currency in Kannada",
          "examples": ["100 rupees as nooru roopayi"],
          "currency_map": {
            "₹": "ರೂಪಾಯಿ", "INR": "ಭಾರತೀಯ ರೂಪಾಯಿ", "Rs": "ರೂಪಾಯಿ"
          },
          "dfa_pattern": "^[₹][0-9]+(\\.[0-9]{1,2})?$|^[0-9]+\\s*rupees?$",
          "rule_type": "currency"
        }
      }
    }
  },
  "ssml_templates": {
    "default": "<speak>{text}</speak>",
    "digit_by_digit": "<speak><say-as interpret-as='characters'>{text}</say-as></speak>",
    "cardinal": "<speak><say-as interpret-as='cardinal'>{text}</say-as></speak>"
  }
}
