{
  "language": "en",
  "language_name": "English",
  "categories": {
    "NUMBER": {
      "subcategories": {
        "cardinal_digit": {
          "description": "Spell each digit separately",
          "examples": ["12345"],
          "pronunciation_map": {
            "0": "zero", "1": "one", "2": "two", "3": "three", "4": "four",
            "5": "five", "6": "six", "7": "seven", "8": "eight", "9": "nine"
          },
          "dfa_pattern": "^[0-9]{5,}$",
          "rule_type": "digit_by_digit"
        },
        "cardinal_million_billion": {
          "description": "Cardinal numbers from 20 to 30 billion",
          "examples": ["25", "500", "1000", "15000", "1000000", "1000000000"],
          "scale_words": {
            "1000": "thousand", "100000": "lakh", "1000000": "million",
            "1000000000": "billion"
          },
          "dfa_pattern": "^[0-9]{2,10}$",
          "rule_type": "cardinal"
        },
        "roman_number": {
          "description": "Roman numerals to be read as words",
          "examples": ["XIV", "IX", "XLII"],
          "roman_map": {
            "I":1,"V":5,"X":10,"L":50,"C":100,"D":500,"M":1000
          },
          "dfa_pattern": "^M{0,4}(CM|CD|D?C{0,3})(XC|XL|L?X{0,3})(IX|IV|V?I{0,3})$",
          "rule_type": "roman_to_cardinal"
        },
        "comma_integer": {
          "description": "Numbers with comma separators, spell in lakhs/thousands",
          "examples": ["10,100", "1,00,000"],
          "dfa_pattern": "^[0-9]{1,2}(,[0-9]{2})*,[0-9]{3}$|^[0-9]+(,[0-9]{3})+$",
          "rule_type": "comma_separated"
        },
        "special_code": {
          "description": "Landline, mobile, country codes, pin codes",
          "examples": ["9.04E+09", "+91-9876543210", "560083"],
          "dfa_pattern": "^(\\+?[0-9]{1,3}[-\\s]?)?[0-9]{5,15}$|^[0-9.]+E[+\\-][0-9]+$",
          "rule_type": "digit_by_digit"
        },
        "ordinal": {
          "description": "Ordinal numbers - first, second, thirteenth",
          "examples": ["1st", "2nd", "3rd", "13th"],
          "suffix_map": {
            "1": "first", "2": "second", "3": "third", "4": "fourth",
            "5": "fifth", "6": "sixth", "7": "seventh", "8": "eighth",
            "9": "ninth", "10": "tenth", "11": "eleventh", "12": "twelfth",
            "13": "thirteenth", "14": "fourteenth", "15": "fifteenth",
            "16": "sixteenth", "17": "seventeenth", "18": "eighteenth",
            "19": "nineteenth", "20": "twentieth"
          },
          "dfa_pattern": "^[0-9]+(st|nd|rd|th)$",
          "rule_type": "ordinal"
        }
      }
    },
    "FRACTION": {
      "subcategories": {
        "normal_fraction": {
          "description": "Interpret value as fraction",
          "examples": ["1/2", "3/2", "1/3", "2/3", "1/4"],
          "fraction_words": {
            "1/2": "half", "1/3": "one third", "1/4": "one quarter",
            "2/3": "two thirds", "3/4": "three quarters"
          },
          "dfa_pattern": "^[0-9]+/[0-9]+$",
          "rule_type": "fraction"
        },
        "mixed_fraction": {
          "description": "Mixed number and fraction",
          "examples": ["5+9/2", "3+1/4"],
          "dfa_pattern": "^[0-9]+\\+[0-9]+/[0-9]+$",
          "rule_type": "mixed_fraction"
        }
      }
    },
    "CHARACTER_READING": {
      "subcategories": {
        "character_reading": {
          "description": "Spell out each letter separately",
          "examples": ["ABC", "hello"],
          "alphabet_map": {
            "a":"ay","b":"bee","c":"see","d":"dee","e":"ee","f":"ef",
            "g":"gee","h":"aitch","i":"eye","j":"jay","k":"kay","l":"el",
            "m":"em","n":"en","o":"oh","p":"pee","q":"queue","r":"ar",
            "s":"es","t":"tee","u":"you","v":"vee","w":"double-you",
            "x":"ex","y":"why","z":"zed"
          },
          "dfa_pattern": "^[A-Za-z]{2,}$",
          "rule_type": "spell_out"
        },
        "acronym": {
          "description": "Abbreviations and acronyms",
          "examples": ["BHU", "SBI", "ISRO", "Samsung", "Google"],
          "dfa_pattern": "^[A-Z]{2,6}$",
          "rule_type": "acronym"
        },
        "samsung_nes": {
          "description": "Samsung specific named entities",
          "examples": ["S23", "S24"],
          "dfa_pattern": "^S[0-9]{1,2}(Ultra|Plus|FE)?$",
          "rule_type": "named_entity"
        },
        "other_specific_nes": {
          "description": "Other specific named entities like G20, 5G",
          "examples": ["G20", "5G", "4G"],
          "dfa_pattern": "^[A-Z][0-9]+|[0-9]+[A-Z]$",
          "rule_type": "alphanumeric_entity"
        },
        "initials_prefix": {
          "description": "Honorifics and prefixes",
          "examples": ["Mr", "Mrs", "Shri", "Sri", "c/o", "D/o", "S/o"],
          "prefix_map": {
            "Mr": "Mister", "Mrs": "Missus", "Ms": "Miss", "Dr": "Doctor",
            "Prof": "Professor", "Shri": "Shri", "Sri": "Sri",
            "c/o": "care of", "D/o": "daughter of", "S/o": "son of"
          },
          "dfa_pattern": "^(Mr|Mrs|Ms|Dr|Prof|Shri|Sri|c\\/o|D\\/o|S\\/o)\\.?$",
          "rule_type": "prefix_expand"
        },
        "word_spell_out": {
          "description": "Spell word letter by letter",
          "examples": ["NATO", "ASAP"],
          "dfa_pattern": "^[A-Z]{3,5}$",
          "rule_type": "spell_out"
        }
      }
    },
    "NAMED_ENTITY": {
      "subcategories": {
        "local_named_entity": {
          "description": "Local named entities",
          "examples": ["Narendra Modi", "Amitabh Bachchan"],
          "dfa_pattern": "^[A-Z][a-z]+(\\s[A-Z][a-z]+)+$",
          "rule_type": "named_entity_local"
        },
        "foreign_named_entity": {
          "description": "Foreign named entities",
          "examples": ["Tom Cruise", "Barack Obama"],
          "dfa_pattern": "^[A-Z][a-z]+(\\s[A-Z][a-z]+)+$",
          "rule_type": "named_entity_foreign"
        }
      }
    },
    "UNIT": {
      "subcategories": {
        "size": {
          "description": "Measurement units - singular/plural based on number",
          "examples": ["10 foot", "10MB", "5 kg"],
          "unit_map": {
            "ft": {"singular": "foot", "plural": "feet"},
            "foot": {"singular": "foot", "plural": "feet"},
            "m": {"singular": "meter", "plural": "meters"},
            "km": {"singular": "kilometer", "plural": "kilometers"},
            "cm": {"singular": "centimeter", "plural": "centimeters"},
            "mm": {"singular": "millimeter", "plural": "millimeters"},
            "MB": {"singular": "megabyte", "plural": "megabytes"},
            "GB": {"singular": "gigabyte", "plural": "gigabytes"},
            "KB": {"singular": "kilobyte", "plural": "kilobytes"},
            "TB": {"singular": "terabyte", "plural": "terabytes"}
          },
          "dfa_pattern": "^[0-9]+(\\.[0-9]+)?\\s*(ft|m|km|cm|mm|MB|GB|KB|TB|inch|inches)$",
          "rule_type": "unit_with_plural"
        },
        "currency": {
          "description": "Currency values",
          "examples": ["$10", "€5", "£20", "₹100"],
          "currency_map": {
            "$": "dollar", "€": "euro", "£": "pound", "₹": "rupee",
            "USD": "US dollar", "EUR": "euro", "GBP": "pound", "INR": "Indian rupee"
          },
          "dfa_pattern": "^[\\$€£₹][0-9]+(\\.[0-9]{1,2})?$|^[0-9]+(\\.[0-9]{1,2})?\\s*(USD|EUR|GBP|INR)$",
          "rule_type": "currency",
          "remarks": "Rules can't be created as they are unique"
        },
        "unit_of_length": {
          "description": "Length units",
          "examples": ["5 ft", "10 yd", "3 mi", "100 cm"],
          "unit_map": {
            "ft": "feet", "yd": "yards", "mi": "miles", "cm": "centimeters",
            "m": "meters", "km": "kilometers", "in": "inches"
          },
          "dfa_pattern": "^[0-9]+(\\.[0-9]+)?\\s*(ft|yd|mi|cm|m|km|in)$",
          "rule_type": "length_unit"
        },
        "area": {
          "description": "Area measurements",
          "examples": ["10 sq ft", "5 sq m"],
          "dfa_pattern": "^[0-9]+(\\.[0-9]+)?\\s*sq\\.?\\s*(ft|m|km|yd)$",
          "rule_type": "area_unit"
        },
        "degree": {
          "description": "Temperature in Celsius or Fahrenheit",
          "examples": ["37°C", "98.6°F"],
          "dfa_pattern": "^[0-9]+(\\.[0-9]+)?\\s*°?\\s*(C|F|Celsius|Fahrenheit)$",
          "rule_type": "temperature",
          "remarks": "Rules can't be created as they are unique"
        },
        "volume": {
          "description": "Volume in cubic units",
          "examples": ["5 cu ft", "3 cu m"],
          "dfa_pattern": "^[0-9]+(\\.[0-9]+)?\\s*cu\\.?\\s*(ft|m|in|yd)$",
          "rule_type": "volume_unit"
        },
        "speed": {
          "description": "Speed in kmph, /hr etc.",
          "examples": ["60 kmph", "30 km/hr", "100 mph"],
          "dfa_pattern": "^[0-9]+(\\.[0-9]+)?\\s*(kmph|km\\/hr|mph|m\\/s)$",
          "rule_type": "speed_unit",
          "remarks": "Further improvement required '/' conflicting with divide"
        },
        "weight": {
          "description": "Weight in kg, gram, ton",
          "examples": ["5 kg", "500 gram", "2 ton"],
          "unit_map": {
            "kg": "kilogram", "g": "gram", "ton": "ton",
            "gram": "gram", "mg": "milligram", "lb": "pound"
          },
          "dfa_pattern": "^[0-9]+(\\.[0-9]+)?\\s*(kg|g|gram|ton|mg|lb)$",
          "rule_type": "weight_unit"
        },
        "time_unit": {
          "description": "Time units",
          "examples": ["30 sec", "5 min", "2 hr"],
          "unit_map": {
            "sec": "second", "min": "minute", "hr": "hour",
            "s": "second", "h": "hour", "ms": "millisecond"
          },
          "dfa_pattern": "^[0-9]+(\\.[0-9]+)?\\s*(sec|min|hr|s|h|ms)$",
          "rule_type": "time_unit"
        }
      }
    },
    "DATE": {
      "subcategories": {
        "date": {
          "description": "Interpret value as date",
          "examples": ["11-07-2025", "2025-07-11"],
          "dfa_pattern": "^[0-9]{1,2}[-/][0-9]{1,2}[-/][0-9]{2,4}$|^[0-9]{4}[-/][0-9]{1,2}[-/][0-9]{1,2}$",
          "rule_type": "date"
        },
        "date_format": {
          "description": "Date format variants",
          "examples": ["10th jul", "10/07"],
          "formats": ["mdy", "dmy", "md", "dm", "ym", "my", "d", "m", "y"],
          "month_map": {
            "jan": "January", "feb": "February", "mar": "March",
            "apr": "April", "may": "May", "jun": "June",
            "jul": "July", "aug": "August", "sep": "September",
            "oct": "October", "nov": "November", "dec": "December"
          },
          "dfa_pattern": "^[0-9]{1,2}(st|nd|rd|th)?\\s*[A-Za-z]{3,9}(\\s*[0-9]{4})?$|^[0-9]{1,2}/[0-9]{1,2}$",
          "rule_type": "date_format"
        }
      }
    },
    "TIME": {
      "subcategories": {
        "usual_time": {
          "description": "Hour, minute, sec with AM/PM or 24hr format",
          "examples": ["12:30:00", "3:45 PM", "14:30"],
          "dfa_pattern": "^[0-9]{1,2}:[0-9]{2}(:[0-9]{2})?\\s*(AM|PM|am|pm)?$",
          "rule_type": "time"
        },
        "time_quantity": {
          "description": "Time quantity like 5'15\"",
          "examples": ["5'15\"", "3'45\""],
          "dfa_pattern": "^[0-9]+'[0-9]{1,2}\"$",
          "rule_type": "time_quantity",
          "remarks": "5'15\" format not feasible but other formats working"
        }
      }
    },
    "EMOJI": {
      "subcategories": {
        "facial_expression": {
          "description": "Facial expression emojis",
          "examples": ["😊", "😢", "😂", ":)", ":(",],
          "emoji_map": {
            "😊": "smile", "😢": "sad", "😂": "laughing", "😍": "heart eyes",
            "😡": "angry", "😮": "surprised", "😴": "sleeping",
            ":)": "smile", ":(": "sad", ":D": "laughing", ";)": "wink"
          },
          "dfa_pattern": "^[:\\-;][()DPp|]$",
          "rule_type": "emoji_facial"
        },
        "eatables": {
          "description": "Food and drink emojis",
          "examples": ["☕", "🍰", "🍵"],
          "emoji_map": {
            "☕": "coffee", "🍵": "tea", "🍰": "cake", "🍕": "pizza",
            "🍔": "burger", "🍎": "apple"
          },
          "rule_type": "emoji_food"
        },
        "others": {
          "description": "Other emojis like heart",
          "examples": ["❤️", "💙", "⭐"],
          "emoji_map": {
            "❤️": "heart", "💙": "blue heart", "⭐": "star",
            "👍": "thumbs up", "👎": "thumbs down"
          },
          "rule_type": "emoji_other"
        }
      }
    },
    "EXCEPTION_LIST": {
      "subcategories": {
        "word_reading": {
          "description": "Homophone disambiguation",
          "examples": ["live", "read", "lead", "wind"],
          "homophones": {
            "live": ["lɪv (to exist)", "laɪv (broadcast)"],
            "read": ["riːd (present)", "rɛd (past)"],
            "lead": ["liːd (to guide)", "lɛd (metal)"],
            "wind": ["wɪnd (breeze)", "waɪnd (to coil)"],
            "tear": ["tɪər (from eye)", "tɛər (to rip)"]
          },
          "dfa_pattern": "^(live|read|lead|wind|tear|row|bow|close|wound)$",
          "rule_type": "homophone"
        }
      }
    },
    "EXTRA_REQUESTS": {
      "subcategories": {
        "weekdays": {
          "description": "All days of the week",
          "examples": ["Mon", "Tue", "Monday"],
          "day_map": {
            "Mon": "Monday", "Tue": "Tuesday", "Wed": "Wednesday",
            "Thu": "Thursday", "Fri": "Friday", "Sat": "Saturday", "Sun": "Sunday"
          },
          "dfa_pattern": "^(Mon|Tue|Wed|Thu|Fri|Sat|Sun)\\.?$|^(Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)$",
          "rule_type": "weekday"
        },
        "months": {
          "description": "All months of the year",
          "examples": ["Jan", "Feb", "January"],
          "month_map": {
            "Jan": "January", "Feb": "February", "Mar": "March",
            "Apr": "April", "May": "May", "Jun": "June",
            "Jul": "July", "Aug": "August", "Sep": "September",
            "Oct": "October", "Nov": "November", "Dec": "December"
          },
          "dfa_pattern": "^(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\\.?$",
          "rule_type": "month"
        },
        "directions": {
          "description": "Cardinal and ordinal directions",
          "examples": ["N", "S", "E", "W", "NE", "SW"],
          "direction_map": {
            "N": "North", "S": "South", "E": "East", "W": "West",
            "NE": "North East", "NW": "North West",
            "SE": "South East", "SW": "South West"
          },
          "dfa_pattern": "^(N|S|E|W|NE|NW|SE|SW)$",
          "rule_type": "direction"
        }
      }
    },
    "PINCODE": {
      "subcategories": {
        "pincode": {
          "description": "Indian PIN codes - read digit by digit",
          "examples": ["560083", "110001"],
          "dfa_pattern": "^[1-9][0-9]{5}$",
          "rule_type": "digit_by_digit",
          "context_keywords": ["pin", "pincode", "zip", "postal"]
        }
      }
    }
  },
  "ssml_templates": {
    "default": "<speak>{text}</speak>",
    "slow": "<speak><prosody rate='slow'>{text}</prosody></speak>",
    "digit_by_digit": "<speak><say-as interpret-as='characters'>{text}</say-as></speak>",
    "cardinal": "<speak><say-as interpret-as='cardinal'>{text}</say-as></speak>",
    "ordinal": "<speak><say-as interpret-as='ordinal'>{text}</say-as></speak>",
    "fraction": "<speak><say-as interpret-as='fraction'>{text}</say-as></speak>",
    "date": "<speak><say-as interpret-as='date' format='{format}'>{text}</say-as></speak>",
    "time": "<speak><say-as interpret-as='time' format='{format}'>{text}</say-as></speak>",
    "spell_out": "<speak><say-as interpret-as='spell-out'>{text}</say-as></speak>",
    "telephone": "<speak><say-as interpret-as='telephone'>{text}</say-as></speak>",
    "unit": "<speak>{number} <w role='amazon:VBD'>{unit}</w></speak>",
    "emphasis": "<speak><emphasis level='moderate'>{text}</emphasis></speak>"
  }
}