{
  "language": "en",
  "language_name": "English",
  "mappings": {
    "digits": {
      "0": "zero", "1": "one", "2": "two", "3": "three", "4": "four",
      "5": "five", "6": "six", "7": "seven", "8": "eight", "9": "nine"
    },
    "cardinal": {
      "scale_words": {
        "100": "hundred", "1000": "thousand", "1000000": "million", "1000000000": "billion"
      }
    },
    "currency": {
      "$": "dollars",
      "USD": "US dollars",
      "£": "pounds",
      "₹": "rupees"
    }
  },
  "categories": {
    "NUMBER": {
      "subcategories": {
        "cardinal_digit": {
          "description": "Spell each digit separately in English",
          "examples": ["12345"],
          "dfa_pattern": "^[0-9]{5,}$",
          "rule_type": "digit_by_digit"
        },
        "cardinal_million_billion": {
          "description": "Cardinal numbers in English scale",
          "examples": ["100"],
          "dfa_pattern": "^[0-9]{2,10}$",
          "rule_type": "cardinal"
        }
      }
    },
    "UNIT": {
      "subcategories": {
        "currency": {
          "description": "Currency in English",
          "examples": ["100 dollars"],
          "dfa_pattern": "^[\\$£₹][0-9]+(\\.[0-9]{1,2})?$|^[0-9]+\\s*(dollars?|pounds?|rupees?)$",
          "rule_type": "currency"
        }
      }
    },
    "PINCODE": {
      "subcategories": {
        "pincode": {
          "description": "PIN code reading",
          "examples": ["560083"],
          "dfa_pattern": "^[1-9][0-9]{5}$",
          "rule_type": "digit_by_digit"
        }
      }
    }
  },
  "ssml_templates": {
    "default": "<speak>{text}</speak>",
    "digit_by_digit": "<speak><say-as interpret-as='characters'>{text}</say-as></speak>",
    "cardinal": "<speak><say-as interpret-as='cardinal'>{text}</say-as></speak>"
  }
}