{
  "language": "hi",
  "language_name": "Hindi",
  "categories": {
    "NUMBER": {
      "subcategories": {
        "cardinal_digit": {
          "description": "Spell each digit separately in Hindi",
          "examples": ["12345"],
          "pronunciation_map": {
            "0": "शून्य", "1": "एक", "2": "दो", "3": "तीन", "4": "चार",
            "5": "पाँच", "6": "छह", "7": "सात", "8": "आठ", "9": "नौ"
          },
          "pronunciation_map_roman": {
            "0": "shunya", "1": "ek", "2": "do", "3": "teen", "4": "char",
            "5": "paanch", "6": "chhe", "7": "saat", "8": "aath", "9": "nau"
          },
          "dfa_pattern": "^[0-9]{5,}$|^[०-९]+$",
          "rule_type": "digit_by_digit"
        },
        "cardinal_million_billion": {
          "description": "Cardinal numbers in Hindi/Indian scale",
          "examples": ["25", "500", "1000", "100000"],
          "scale_words": {
            "100": "सौ", "1000": "हज़ार", "100000": "लाख",
            "10000000": "करोड़", "1000000000": "अरब"
          },
          "scale_words_roman": {
            "100": "sau", "1000": "hazar", "100000": "lakh",
            "10000000": "crore", "1000000000": "arab"
          },
          "ones": ["", "एक", "दो", "तीन", "चार", "पाँच", "छह", "सात", "आठ", "नौ",
                   "दस", "ग्यारह", "बारह", "तेरह", "चौदह", "पंद्रह", "सोलह",
                   "सत्रह", "अठारह", "उन्नीस"],
          "tens": ["", "", "बीस", "तीस", "चालीस", "पचास", "साठ", "सत्तर", "अस्सी", "नब्बे"],
          "dfa_pattern": "^[0-9]{2,10}$",
          "rule_type": "cardinal"
        },
        "ordinal": {
          "description": "Ordinal numbers in Hindi",
          "examples": ["1st", "2nd"],
          "ordinal_map_roman": {
            "1": "pehla", "2": "doosra", "3": "teesra", "4": "chautha", "5": "paanchva"
          },
          "dfa_pattern": "^[0-9]+(st|nd|rd|th)$",
          "rule_type": "ordinal"
        }
      }
    },
    "FRACTION": {
      "subcategories": {
        "normal_fraction": {
          "description": "Fraction reading in Hindi",
          "examples": ["1/2", "3/4"],
          "fraction_words": {
            "1/2": "आधा", "1/3": "एक तिहाई", "1/4": "एक चौथाई",
            "3/4": "तीन चौथाई"
          },
          "fraction_words_roman": {
            "1/2": "aadha", "1/3": "ek tihai", "1/4": "ek chauthai"
          },
          "dfa_pattern": "^[0-9]+/[0-9]+$",
          "rule_type": "fraction"
        }
      }
    },
    "CHARACTER_READING": {
      "subcategories": {
        "acronym": {
          "description": "Abbreviations in Hindi context",
          "examples": ["SBI", "ISRO", "BJP"],
          "dfa_pattern": "^[A-Z]{2,6}$",
          "rule_type": "acronym"
        },
        "initials_prefix": {
          "description": "Hindi honorifics",
          "examples": ["श्री", "श्रीमती", "डॉ."],
          "prefix_map": {
            "श्री": "Shri", "श्रीमती": "Shrimati", "डॉ": "Doctor",
            "Mr": "Mister", "Mrs": "Missus", "Dr": "Doctor",
            "Shri": "Shri"
          },
          "dfa_pattern": "^(Mr|Mrs|Ms|Dr|Shri)\\.?$",
          "rule_type": "prefix_expand"
        }
      }
    },
    "UNIT": {
      "subcategories": {
        "size": {
          "description": "Measurement units in Hindi",
          "examples": ["10 foot", "5 kg"],
          "unit_map": {
            "ft": {"singular": "फ़ुट", "plural": "फ़ुट", "roman": "foot"},
            "m": {"singular": "मीटर", "plural": "मीटर", "roman": "meter"},
            "km": {"singular": "किलोमीटर", "plural": "किलोमीटर", "roman": "kilometer"},
            "kg": {"singular": "किलोग्राम", "plural": "किलोग्राम", "roman": "kilogram"}
          },
          "dfa_pattern": "^[0-9]+(\\.[0-9]+)?\\s*(ft|m|km|cm|kg|g|MB|GB)$",
          "rule_type": "unit_with_plural"
        },
        "currency": {
          "description": "Currency in Hindi",
          "examples": ["₹100 as ek sau rupaye", "100 rupees as ek sau rupaye"],
          "currency_map": {
            "₹": "रुपये", "INR": "भारतीय रुपये", "Rs": "रुपये"
          },
          "dfa_pattern": "^[₹][0-9]+(\\.[0-9]{1,2})?$|^[0-9]+\\s*rupees?$",
          "rule_type": "currency"
        }
      }
    },
    "DATE": {
      "subcategories": {
        "date": {
          "description": "Date in Hindi",
          "examples": ["11-07-2025"],
          "month_map": {
            "jan": "जनवरी", "feb": "फ़रवरी", "mar": "मार्च",
            "apr": "अप्रैल", "may": "मई", "jun": "जून",
            "jul": "जुलाई", "aug": "अगस्त", "sep": "सितंबर",
            "oct": "अक्तूबर", "nov": "नवंबर", "dec": "दिसंबर"
          },
          "dfa_pattern": "^[0-9]{1,2}[-/][0-9]{1,2}[-/][0-9]{2,4}$",
          "rule_type": "date"
        }
      }
    },
    "TIME": {
      "subcategories": {
        "usual_time": {
          "description": "Time in Hindi",
          "examples": ["12:30", "3:45 PM"],
          "time_words": {
            "AM": "सुबह", "PM": "शाम"
          },
          "dfa_pattern": "^[0-9]{1,2}:[0-9]{2}(:[0-9]{2})?\\s*(AM|PM)?$",
          "rule_type": "time"
        }
      }
    },
    "EXTRA_REQUESTS": {
      "subcategories": {
        "weekdays": {
          "description": "Days of week in Hindi",
          "day_map": {
            "Mon": "सोमवार", "Tue": "मंगलवार", "Wed": "बुधवार",
            "Thu": "गुरुवार", "Fri": "शुक्रवार", "Sat": "शनिवार", "Sun": "रविवार"
          },
          "dfa_pattern": "^(Mon|Tue|Wed|Thu|Fri|Sat|Sun)\\.?$",
          "rule_type": "weekday"
        },
        "months": {
          "description": "Months in Hindi",
          "month_map": {
            "Jan": "जनवरी", "Feb": "फ़रवरी", "Mar": "मार्च",
            "Apr": "अप्रैल", "May": "मई", "Jun": "जून",
            "Jul": "जुलाई", "Aug": "अगस्त", "Sep": "सितंबर",
            "Oct": "अक्तूबर", "Nov": "नवंबर", "Dec": "दिसंबर"
          },
          "dfa_pattern": "^(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\\.?$",
          "rule_type": "month"
        }
      }
    },
    "PINCODE": {
      "subcategories": {
        "pincode": {
          "description": "Indian PIN codes in Hindi context",
          "examples": ["110001", "400001"],
          "dfa_pattern": "^[1-9][0-9]{5}$",
          "rule_type": "digit_by_digit",
          "context_keywords": ["pin", "pincode", "पिन", "पिनकोड"]
        }
      }
    }
  },
  "ssml_templates": {
    "default": "<speak>{text}</speak>",
    "digit_by_digit": "<speak><say-as interpret-as='characters'>{text}</say-as></speak>",
    "cardinal": "<speak><say-as interpret-as='cardinal'>{text}</say-as></speak>",
    "ordinal": "<speak><say-as interpret-as='ordinal'>{text}</say-as></speak>",
    "date": "<speak><say-as interpret-as='date' format='{format}'>{text}</say-as></speak>",
    "time": "<speak><say-as interpret-as='time' format='{format}'>{text}</say-as></speak>",
    "spell_out": "<speak><say-as interpret-as='spell-out'>{text}</say-as></speak>"
  }
}