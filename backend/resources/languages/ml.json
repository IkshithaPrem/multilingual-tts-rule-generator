{
  "language": "ml",
  "language_name": "Malayalam",
  "mappings": {
    "digits": {
      "0": "പൂജ്യം", "1": "ഒന്ന്", "2": "രണ്ട്", "3": "മൂന്ന്", "4": "നാല്",
      "5": "അഞ്ച്", "6": "ആറ്", "7": "ഏഴ്", "8": "എട്ട്", "9": "ഒമ്പത്"
    },
    "cardinal": {
      "scale_words": {
        "100": "നൂറ്", "1000": "ആയിരം", "100000": "ലക്ഷം", "10000000": "കോടി"
      }
    },
    "currency": {
      "₹": "രൂപ",
      "INR": "ഇന്ത്യൻ രൂപ",
      "Rs": "രൂപ"
    }
  },
  "categories": {
    "NUMBER": {
      "subcategories": {
        "cardinal_digit": {
          "description": "Spell each digit separately in Malayalam",
          "examples": ["12345"],
          "dfa_pattern": "^[0-9]{5,}$",
          "rule_type": "digit_by_digit"
        },
        "cardinal_million_billion": {
          "description": "Cardinal numbers in Malayalam scale",
          "examples": ["100"],
          "dfa_pattern": "^[0-9]{2,10}$",
          "rule_type": "cardinal"
        }
      }
    },
    "UNIT": {
      "subcategories": {
        "currency": {
          "description": "Currency in Malayalam",
          "examples": ["100 rupees"],
          "dfa_pattern": "^[₹][0-9]+(\\.[0-9]{1,2})?$|^[0-9]+\\s*rupees?$",
          "rule_type": "currency"
        }
      }
    },
    "PINCODE": {
      "subcategories": {
        "pincode": {
          "description": "PIN code reading",
          "examples": ["560083"],
          "dfa_pattern": "^[1-9][0-9]{5}$",
          "rule_type": "digit_by_digit"
        }
      }
    }
  },
  "ssml_templates": {
    "default": "<speak>{text}</speak>",
    "digit_by_digit": "<speak><say-as interpret-as='characters'>{text}</say-as></speak>",
    "cardinal": "<speak><say-as interpret-as='cardinal'>{text}</say-as></speak>"
  }
}
